
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============================================== -->
    <!-- PERMISOS DE TARPON MX                          -->
    <!-- ============================================== -->

    <!-- Permite consultar APIs como Open-Meteo. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ============================================== -->
    <!-- CONFIGURACIÓN GENERAL DE LA APLICACIÓN         -->
    <!-- ============================================== -->

    <!--
        android:label:
        Nombre visible de la aplicación en Android.

        android:name:
        Clase de aplicación configurada por Flutter.

        android:icon:
        Icono de la aplicación en Android.
    -->
    <application
        android:label="Tarpon MX"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- ========================================== -->
        <!-- ACTIVIDAD PRINCIPAL                        -->
        <!-- ========================================== -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Tema utilizado mientras Flutter inicia. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- Permite iniciar Tarpon MX desde Android. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Registro de plugins de Flutter. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

    <!-- ============================================== -->
    <!-- CONSULTAS A OTRAS APLICACIONES                 -->
    <!-- ============================================== -->

    <!-- Aplicaciones compatibles con procesar texto. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

</manifest>
